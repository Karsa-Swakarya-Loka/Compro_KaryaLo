# Salin ke .env.local lalu isi nilainya. Jangan commit .env.local.

# SMTP untuk form kontak (Hostinger). Tanpa ini form tetap jalan lewat pratinjau WhatsApp.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@karyalo.com
SMTP_PASS=
# Opsional. Default: MAIL_TO = support@karyalo.com, MAIL_FROM = SMTP_USER
# MAIL_TO=
# MAIL_FROM=

# Opsional. ID container Google Tag Manager, mis. GTM-XXXXXXX. Kosong = tidak ada skrip pihak ketiga.
NEXT_PUBLIC_GTM_ID=
